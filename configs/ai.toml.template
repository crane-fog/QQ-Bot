[provider.deepseek]
base_url = "https://api.deepseek.com"
api_key = "<your-api-key>"
timeout_seconds = 60.0 # 可选参数

[provider.myapi]
base_url = "http://127.0.0.1:3000/v1"
api_key = "<your-api-key>"

[provider.tavily]
base_url = "https://api.tavily.com"
api_key = "<your-api-key>"

[profile.example]
provider = "deepseek"
model = "deepseek-flash"
response_format = {"type" = "json_object"} # 可选参数
reasoning_effort = "xhigh" # 可选参数
extra_body.thinking.type = "disabled" # 可选参数，用于 deepseek
tools = ["set_group_ban"] # 可选参数
max_turns = 5 # 可选参数，在使用 tools 时才有必要填写，默认 5
insert_persona = false # 可选参数，默认 false

[profile.default]
provider = "deepseek"
model = "deepseek-flash"

[profile.group_sum]
provider = "deepseek"
model = "deepseek-flash"
response_format = {"type" = "json_object"}
insert_persona = true

[profile.Theresa_simple]
provider = "deepseek"
model = "deepseek-flash"
insert_persona = true

[profile.chat]
provider = "deepseek"
model = "deepseek-flash"
tools = ["send_private_msg", "send_group_msg", "get_group_member_list", "get_group_member_info", "set_group_ban", "set_group_kick", "delete_msg", "get_group_info", "set_msg_emoji_like", "send_group_poke", "get_msg", "shell", "read_img_file", "set_notification"]
max_turns = 10
insert_persona = true

[profile.chat_face]
provider = "deepseek"
model = "deepseek-flash"
response_format = {"type" = "json_object"}
insert_persona = true

[profile.image_simple]
provider = "deepseek"
model = "deepseek-flash"
